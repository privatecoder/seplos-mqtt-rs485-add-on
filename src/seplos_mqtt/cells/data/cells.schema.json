{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/privatecoder/openbms-monitor/data/schema/cells.schema.json",
  "title": "OpenBMS cell database",
  "description": "Array of cell models. A missing value means 'unknown' or 'not stated in the datasheet' (then its provenance says so); null is not allowed. Rates always carry their basis (C or P).",
  "type": "array",
  "items": { "$ref": "#/$defs/cell" },
  "$defs": {
    "rate": {
      "type": "object",
      "required": ["value", "basis"],
      "properties": { "value": { "type": "number", "minimum": 0 }, "basis": { "enum": ["C", "P"] } },
      "additionalProperties": false
    },
    "deratingPoint": {
      "description": "Max continuous charge rate at a cell temperature (temp_c) or in a temperature band (temp_min_c and/or temp_max_c; an open band has only one bound), optionally for a SOC band. Bounds as printed in the datasheet.",
      "type": "object",
      "required": ["value"],
      "properties": {
        "temp_c": { "type": "number" },
        "temp_min_c": { "type": "number" },
        "temp_max_c": { "type": "number" },
        "soc_min_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "soc_max_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "value": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false,
      "oneOf": [
        { "required": ["temp_c"], "not": { "anyOf": [{ "required": ["temp_min_c"] }, { "required": ["temp_max_c"] }] } },
        { "anyOf": [{ "required": ["temp_min_c"] }, { "required": ["temp_max_c"] }], "not": { "required": ["temp_c"] } }
      ]
    },
    "derating": {
      "description": "Temperature-dependent max continuous charge rate, transcribed from the datasheet. Between two points (temperature or SOC) and on shared band bounds the app uses the LOWER value; outside the table charging is not allowed. Linear interpolation only if the datasheet explicitly allows it ('interpolation': 'linear', with proof in provenance).",
      "type": "object",
      "required": ["basis", "points"],
      "properties": {
        "basis": { "enum": ["C", "P"] },
        "interpolation": { "enum": ["linear"] },
        "points": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/deratingPoint" } }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["verified"],
      "properties": {
        "verified": { "type": "boolean" },
        "source": { "type": "string", "format": "uri", "description": "Only when the value comes from a different document than datasheet.url." },
        "page": { "type": "integer" },
        "table": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "cell": {
      "type": "object",
      "required": ["schema_version", "id", "entry_version", "updated", "manufacturer", "model", "chemistry", "datasheet"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "entry_version": { "type": "integer", "minimum": 1 },
        "updated": { "type": "string", "format": "date" },
        "manufacturer": { "type": "string" },
        "model": { "type": "string" },
        "variant": { "type": "string" },
        "chemistry": { "enum": ["LFP", "NMC", "LTO", "NA-ION", "OTHER"] },
        "form_factor": { "enum": ["prismatic", "cylindrical", "pouch"] },
        "datasheet": {
          "type": "object",
          "required": ["title", "source_type", "url"],
          "properties": {
            "title": { "type": "string" },
            "revision": { "type": "string" },
            "document_date": { "type": "string" },
            "source_type": { "enum": ["manufacturer_pdf", "manufacturer_web", "distributor_pdf"], "description": "Who authored the document, not where it is hosted." },
            "url": { "type": "string", "format": "uri", "description": "Where the document was read (may be a third-party host)." },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "additionalProperties": false
        },
        "capacity": {
          "type": "object",
          "properties": {
            "nominal_ah": { "type": "number", "exclusiveMinimum": 0 },
            "minimum_ah": { "type": "number", "exclusiveMinimum": 0 },
            "nominal_energy_wh": { "type": "number", "exclusiveMinimum": 0 },
            "test_condition": {
              "type": "object",
              "properties": { "rate": { "$ref": "#/$defs/rate" }, "temperature_c": { "type": "number" } },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "voltage": {
          "type": "object",
          "properties": {
            "nominal_v": { "type": "number" },
            "charge_cutoff_v": { "type": "number" },
            "discharge_cutoff_v": { "type": "number" },
            "discharge_cutoff_low_temp_v": { "type": "number", "description": "Lower discharge cut-off allowed at low temperature; the temperature condition goes into the provenance note." },
            "operating_min_v": { "type": "number" },
            "operating_max_v": { "type": "number" },
            "storage_v": { "type": "number" }
          },
          "additionalProperties": false
        },
        "current": {
          "type": "object",
          "properties": {
            "standard_charge": { "$ref": "#/$defs/rate" },
            "standard_discharge": { "$ref": "#/$defs/rate" },
            "max_continuous_charge_a": { "type": "number", "minimum": 0 },
            "max_continuous_discharge_a": { "type": "number", "minimum": 0 },
            "pulse_charge": { "$ref": "#/$defs/rate" },
            "pulse_discharge": { "$ref": "#/$defs/rate" }
          },
          "additionalProperties": false
        },
        "temperature": {
          "type": "object",
          "properties": {
            "charge_min_c": { "type": "number" },
            "charge_max_c": { "type": "number" },
            "discharge_min_c": { "type": "number" },
            "discharge_max_c": { "type": "number" },
            "storage_min_c": { "type": "number" },
            "storage_max_c": { "type": "number" }
          },
          "additionalProperties": false
        },
        "charge_derating": { "$ref": "#/$defs/derating" },
        "provenance": {
          "description": "One entry per value, keyed by its dotted path (e.g. 'voltage.charge_cutoff_v', 'charge_derating'). A value the datasheet does not state is omitted; its entry stays with verified: true and a note 'not specified in datasheet …'.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/provenance" }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
