{
  "about": "Shared vectors for src/seplos_mqtt/cells/balancer.py. Ported by reading from OpenBMS Monitor (app/src-tauri/src/balancer.rs, Tracker::step and its tests, single answers only); a case with a 'deviation' note follows the add-on design (docs/design/ingress-app.md, stage 3c) instead and lists what OpenBMS answers in 'openbms'. A step is one fresh sample: 'spread' (mV above a lowest cell of 3300 mV) or 'cells_mv' (explicit list, [] = no cells), 'current_a' (charging positive, default 0, null = no current), or 'sample' = 'missing' | 'stale'. 'expect' is the state after the step. Every case starts from 'unknown' (the state after a restart).",
  "cases": [
    {"name": "starts at the trigger, stops below the stop (hysteresis between)", "profile": {"trigger_mv": 10, "stop_mv": 5, "when": "always"},
     "steps": [{"spread": 4, "expect": "inactive"}, {"spread": 10, "expect": "active"}, {"spread": 7, "expect": "active"}, {"spread": 5, "expect": "active"},
               {"spread": 4, "expect": "inactive"}, {"spread": 7, "expect": "inactive"}, {"spread": 12, "expect": "active"}]},
    {"name": "no stop: no hysteresis", "profile": {"trigger_mv": 10, "stop_mv": null, "when": "always"},
     "steps": [{"spread": 4, "expect": "inactive"}, {"spread": 10, "expect": "active"}, {"spread": 7, "expect": "inactive"}, {"spread": 9, "expect": "inactive"},
               {"spread": 10, "expect": "active"}, {"spread": 9, "expect": "inactive"}]},
    {"name": "stop above the trigger: no hysteresis", "profile": {"trigger_mv": 10, "stop_mv": 20, "when": "always"},
     "steps": [{"spread": 4, "expect": "inactive"}, {"spread": 10, "expect": "active"}, {"spread": 7, "expect": "inactive"}, {"spread": 12, "expect": "active"}]},
    {"name": "stop equal to the trigger: no hysteresis", "profile": {"trigger_mv": 10, "stop_mv": 10, "when": "always"},
     "steps": [{"spread": 10, "expect": "active"}, {"spread": 9, "expect": "inactive"}]},
    {"name": "equality at the stop keeps, one below stops", "profile": {"trigger_mv": 10, "stop_mv": 5, "when": "always"},
     "steps": [{"spread": 12, "expect": "active"}, {"spread": 5, "expect": "active"}, {"spread": 4, "expect": "inactive"}]},
    {"name": "charging: above +1 A only", "profile": {"trigger_mv": 10, "stop_mv": 5, "when": "charging"},
     "steps": [{"spread": 20, "current_a": 1.0, "expect": "inactive"}, {"spread": 20, "current_a": 1.01, "expect": "active"},
               {"spread": 20, "current_a": 1.0, "expect": "inactive"}, {"spread": 20, "current_a": 1.01, "expect": "active"},
               {"spread": 20, "current_a": -5, "expect": "inactive"}]},
    {"name": "not-discharging: from -1 A on", "profile": {"trigger_mv": 10, "stop_mv": 5, "when": "not-discharging"},
     "steps": [{"spread": 20, "current_a": -1.0, "expect": "active"}, {"spread": 20, "current_a": -1.01, "expect": "inactive"},
               {"spread": 20, "current_a": 40, "expect": "active"}, {"spread": 20, "current_a": 0, "expect": "active"}]},
    {"name": "always: any current", "profile": {"trigger_mv": 10, "stop_mv": 5, "when": "always"},
     "steps": [{"spread": 20, "current_a": -300, "expect": "active"}, {"spread": 20, "current_a": 300, "expect": "active"}]},
    {"name": "a failing condition stops inside the hysteresis band", "profile": {"trigger_mv": 10, "stop_mv": 5, "when": "charging"},
     "steps": [{"spread": 20, "current_a": 5, "expect": "active"}, {"spread": 7, "current_a": 5, "expect": "active"}, {"spread": 7, "current_a": 0, "expect": "inactive"}]},
    {"name": "the highest cell must reach the start (equality starts)", "profile": {"start_mv": 3320, "trigger_mv": 10, "stop_mv": 5, "when": "always"},
     "steps": [{"spread": 15, "expect": "inactive"}, {"spread": 20, "expect": "active"}, {"spread": 19, "expect": "inactive"}]},
    {"name": "a stop cell above the start is the start", "profile": {"start_mv": 3320, "stop_cell_mv": 3400, "trigger_mv": 10, "stop_mv": 5, "when": "always"},
     "steps": [{"spread": 15, "expect": "inactive"}, {"spread": 25, "expect": "active"}, {"spread": 15, "expect": "inactive"}, {"spread": 8, "expect": "inactive"},
               {"spread": 15, "expect": "inactive"}, {"spread": 25, "expect": "active"}]},
    {"name": "a stop cell equal to the start is the start", "profile": {"start_mv": 3320, "stop_cell_mv": 3320, "trigger_mv": 10, "stop_mv": 5, "when": "always"},
     "steps": [{"spread": 25, "expect": "active"}, {"spread": 19, "expect": "inactive"}]},
    {"name": "stop cell below the start runs down to the stop cell", "profile": {"start_mv": 3320, "stop_cell_mv": 3310, "trigger_mv": 10, "stop_mv": 5, "when": "always"},
     "deviation": "the first sample (highest cell 3315, between the stop cell 3310 and the start 3320, spread inside the band) cannot decide: the add-on says unknown, OpenBMS starts the row before as inactive",
     "openbms": ["inactive", "active", "active", "inactive", "inactive", "active"],
     "steps": [{"spread": 15, "expect": "unknown"}, {"spread": 25, "expect": "active"}, {"spread": 15, "expect": "active"}, {"spread": 8, "expect": "inactive"},
               {"spread": 15, "expect": "inactive"}, {"spread": 25, "expect": "active"}]},
    {"name": "equality at the stop cell keeps, one below stops", "profile": {"start_mv": 3320, "stop_cell_mv": 3310, "trigger_mv": 10, "stop_mv": 5, "when": "always"},
     "steps": [{"spread": 25, "expect": "active"}, {"spread": 10, "expect": "active"}, {"spread": 9, "expect": "inactive"}]},
    {"name": "the stop cell is ignored without a start", "profile": {"start_mv": null, "stop_cell_mv": 3310, "trigger_mv": 10, "stop_mv": 5, "when": "always"},
     "steps": [{"spread": 12, "expect": "active"}, {"spread": 7, "expect": "active"}, {"spread": 4, "expect": "inactive"}]},
    {"name": "starts unknown: a sample in the hysteresis band does not decide", "profile": {"trigger_mv": 10, "stop_mv": 5, "when": "always"},
     "deviation": "a restart, like any reset, is unknown until a sample decides (rows 1 and 2 are in the band between stop and trigger); OpenBMS starts every session inactive",
     "openbms": ["inactive", "inactive", "active", "active", "inactive"],
     "steps": [{"spread": 7, "expect": "unknown"}, {"spread": 7, "expect": "unknown"}, {"spread": 12, "expect": "active"}, {"spread": 7, "expect": "active"}, {"spread": 4, "expect": "inactive"}]},
    {"name": "starts unknown: below the stop decides inactive", "profile": {"trigger_mv": 10, "stop_mv": 5, "when": "always"},
     "steps": [{"spread": 4, "expect": "inactive"}, {"spread": 7, "expect": "inactive"}]},
    {"name": "starts unknown: a failing condition decides inactive", "profile": {"trigger_mv": 10, "stop_mv": 5, "when": "charging"},
     "steps": [{"spread": 7, "current_a": 0, "expect": "inactive"}]},
    {"name": "starts unknown without hysteresis: decided by the first sample", "profile": {"trigger_mv": 10, "stop_mv": null, "when": "always"},
     "steps": [{"spread": 7, "expect": "inactive"}]},
    {"name": "a sample without cells is unknown until the spread decides", "profile": {"trigger_mv": 10, "stop_mv": 5, "when": "always"},
     "steps": [{"spread": 12, "expect": "active"}, {"cells_mv": [], "expect": "unknown"}, {"spread": 7, "expect": "unknown"}, {"spread": 12, "expect": "active"}, {"spread": 7, "expect": "active"}]},
    {"name": "a sample without cells, then below the stop", "profile": {"trigger_mv": 10, "stop_mv": 5, "when": "always"},
     "steps": [{"cells_mv": [], "expect": "unknown"}, {"spread": 4, "expect": "inactive"}]},
    {"name": "a sample without current is not decisive, even with 'always'", "profile": {"trigger_mv": 10, "stop_mv": 5, "when": "always"},
     "steps": [{"spread": 12, "expect": "active"}, {"spread": 12, "current_a": null, "expect": "unknown"}, {"spread": 7, "expect": "unknown"}, {"spread": 12, "expect": "active"}]},
    {"name": "a missing or stale sample is unknown and the band holds unknown", "profile": {"trigger_mv": 10, "stop_mv": 5, "when": "always"},
     "deviation": "a stale or missing sample resets to unknown (OpenBMS has no live staleness, only gaps that start inactive)",
     "steps": [{"spread": 12, "expect": "active"}, {"sample": "stale", "expect": "unknown"}, {"spread": 7, "expect": "unknown"}, {"spread": 12, "expect": "active"}]},
    {"name": "a missing sample, then a deciding one", "profile": {"trigger_mv": 10, "stop_mv": 5, "when": "always"},
     "steps": [{"sample": "missing", "expect": "unknown"}, {"spread": 4, "expect": "inactive"}]},
    {"name": "a single cell has no spread", "profile": {"trigger_mv": 1, "stop_mv": null, "when": "always"},
     "steps": [{"cells_mv": [3300], "expect": "inactive"}]},
    {"name": "the spread is highest minus lowest of all cells", "profile": {"trigger_mv": 10, "stop_mv": null, "when": "always"},
     "steps": [{"cells_mv": [3300, 3305, 3310, 3302], "expect": "active"}, {"cells_mv": [3300, 3305, 3309, 3302], "expect": "inactive"}]}
  ]
}
